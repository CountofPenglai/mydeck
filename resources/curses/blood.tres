[resource]
script = ExtResource("1_definition")
curse_id = "blood"
display_name = "鲜血"
is_boss_curse = false
maturity_threshold = 3
industry_description = "持有者须拥有多于 3+2D 点生命才能打出血之业。持有者失去 3+2D 点生命，然后对范围 3 内每名敌人造成 8+4D 点固定伤害；每名敌人实际损失多少生命，持有者便恢复多少生命。"
report_description = "持有者受到的治疗改为获得等量护甲。每次行动中，持有者首次因非诅咒牌或无牌来源的伤害而失去生命后，额外失去 D+1 点生命。"
fruit_description = "持有者受到的治疗改为获得等量护甲。每回合一次，若持有者生命多于 2D 点，其可以失去 2D 点生命，使下一张攻击牌每段获得 +2D 伤害加值并按实际生命伤害吸血。"
industry_card = ExtResource("2_card")
effect = SubResource("Effect")
