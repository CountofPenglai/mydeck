[resource]
script = ExtResource("1_definition")
curse_id = "counterfeit"
display_name = "赝作"
is_boss_curse = false
maturity_threshold = 3
industry_description = "持有者选择另一张深度低于 3 的诅咒和 1 张非诅咒手牌。将所选诅咒加深 1，然后复制所选手牌并将副本加入手牌；副本 AP 消耗 -D，最低为 0，打出后或本回合结束时放逐。"
report_description = "持有者下一项尚未领取的畸变里程碑阈值 +D。每场战斗中，持有者前 D 张在抽牌阶段之外抽到的牌离开手牌时改为进入放逐区。"
fruit_description = "持有者的畸变进度至少为 2 时，本诅咒不计入负荷。每回合一次，持有者可以消耗 2D 点咒波，复制本回合最后打出的非诅咒牌并将副本加入手牌；副本 AP 消耗 -1，最低为 0，打出后或本回合结束时放逐。"
industry_card = ExtResource("2_card")
effect = SubResource("Effect")
