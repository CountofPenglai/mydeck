[resource]
script = ExtResource("1_definition")
curse_id = "cripple"
display_name = "跛行"
is_boss_curse = false
maturity_threshold = 3
industry_description = "持有者获得 4 层眩晕，并选择距自身不超过 3+D 格的目标格。若目标格合法且空置，持有者传送至该格；否则留在原位。然后持有者获得 2+D AP。"
report_description = "持有者每打出 1 张牌便获得 D 点咒波。持有者每次主动移动完成后，失去 D+ceil（当前咒波/3）点生命，然后消耗至多 D 点咒波。"
fruit_description = "持有者的普通移动 AP 消耗 +1。每回合一次，持有者可以选择 D+1 格内的空格，消耗等同于移动格数的咒波并传送至该格，然后抽 1 张牌并弃置手牌末尾 1 张牌。"
industry_card = ExtResource("2_card")
effect = SubResource("Effect")
