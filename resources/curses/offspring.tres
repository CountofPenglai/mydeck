[resource]
script = ExtResource("1_definition")
curse_id = "offspring"
display_name = "孽生"
is_boss_curse = true
maturity_threshold = 4
industry_description = "持有者在范围 3 内选择 1 个空格，召唤具有 10+5D 生命的友方活根；召唤失败时效果结束。召唤成功后，以每名其他友方各 1 次、该活根 2 次为原点，对各原点范围 1 内每名敌人造成 3+D 点固定伤害，然后持有者恢复等同于这些伤害造成的实际生命损失总和的生命。"
report_description = "战斗开始时，在首名敌人 2 格内的可用位置生成具有 10+5D 生命的敌方活根。持有者回合结束时，每个敌方活根对距离最近的友方单位造成 3+D 点伤害。"
fruit_description = "战斗开始时，在持有者 2 格内的可用位置生成具有 10+5D 生命的友方活根。持有者可以从该活根所在格计算效果范围；活根每次实际失去生命时，持有者同步失去等量生命，活根自身仍承受该伤害。"
industry_card = ExtResource("2_card")
effect = SubResource("Effect")
