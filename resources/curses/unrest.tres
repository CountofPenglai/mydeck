[resource]
script = ExtResource("1_definition")
curse_id = "unrest"
display_name = "不休"
is_boss_curse = false
maturity_threshold = 4
industry_description = "将持有者的当前生命设为 1。直到本回合结束，对持有者的致命伤害或生命损失最低将生命降至 1。持有者获得 2+D AP，然后抽 D 张牌。"
report_description = "持有者死亡时标记本诅咒。战斗结束后，若存在没有不休且仍存活的其他冒险者，将本诅咒随机转移给其中一人并加深 1；没有合法承受者时留在原持有者处。"
fruit_description = "每场战斗一次，持有者受到致命伤害或生命损失时改为降至 1 点生命，并获得 3D 护甲和 D 点咒波。若本场触发，战斗结束后其生命上限 -2D；此减值在其下一次未再次触发本效果的胜利结算后恢复。"
industry_card = ExtResource("2_card")
effect = SubResource("Effect")
