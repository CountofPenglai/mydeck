[resource]
script = ExtResource("1_definition")
curse_id = "passing"
display_name = "遗逝"
is_boss_curse = false
maturity_threshold = 3
industry_description = "持有者弃置所有其他手牌，然后从任意单位当前弃牌堆选择至多 D+1 张牌，在自身手牌中生成其 0 AP 副本；副本打出后或本回合结束时放逐。"
report_description = "持有者每次洗牌前失去 2+D 点生命并获得 D 点咒波。其抽牌阶段开始前磨 D 张牌。"
fruit_description = "持有者不能自动将弃牌堆洗入牌库。每回合一次，其可以从弃牌堆选择 1 张牌移入手牌；若咒波至少为 D，消耗 D 点咒波，否则失去 2D 点生命。该牌 AP 消耗 -1，最低为 0，打出后或本回合结束时放逐。"
industry_card = ExtResource("2_card")
effect = SubResource("Effect")
