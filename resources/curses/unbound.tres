[resource]
script = ExtResource("1_definition")
curse_id = "unbound"
display_name = "无羁"
is_boss_curse = true
maturity_threshold = 4
industry_description = "本牌结算后结束持有者的当前回合，跳过下一名敌人的抽牌与行动，然后持有者获得 1 个额外行动阶段；该阶段的当前 AP 改为 2+D，而非在原 AP 上增加。"
report_description = "持有者本场战斗每使用 1 种新的行动类别，便立即封锁该类别。五种行动类别全部封锁后，其下一行动阶段开始时解除全部封锁，并使当前 AP -D。"
fruit_description = "每个行动阶段中，持有者最多使用 2 种行动类别，且不能使用上一行动阶段用过的类别。每首次使用 1 种本阶段的新类别，获得 D 点咒波；首次使用第 2 种类别时再获得 2 AP。"
industry_card = ExtResource("2_card")
effect = SubResource("Effect")
