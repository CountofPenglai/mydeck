[resource]
script = ExtResource("1_definition")
curse_id = "possession"
display_name = "凭依"
is_boss_curse = false
maturity_threshold = 3
industry_description = "令范围 3 内 1 名敌人立即对距离最近的另一名同阵营单位进行 1 次获得 +2D 伤害加值的武器打击；若没有合法目标，令该敌人对自己造成等同于其当前攻击值的伤害。"
report_description = "持有者的行动阶段开始时，随机禁用 min（2，D）种行动类别，持续到该行动阶段结束；D 为 3 时，其当前 AP 额外 -1。"
fruit_description = "每回合一次，持有者选择禁用 1 种行动类别，持续到本行动阶段结束，然后获得 2D 点咒波和 2 AP。"
industry_card = ExtResource("2_card")
effect = SubResource("Effect")
