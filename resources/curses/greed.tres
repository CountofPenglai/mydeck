[resource]
script = ExtResource("1_definition")
curse_id = "greed"
display_name = "贪欲"
is_boss_curse = false
maturity_threshold = 3
industry_description = "持有者预先从所有单位的弃牌堆和自身牌库选择至多 2+D 张牌；若候选不足则选择全部。持有者磨空牌库，然后将所选牌从其当前弃牌堆移入自身手牌。"
report_description = "持有者每次完成抽牌阶段之外的抽牌行动后，随机弃置至多 D 张手牌。"
fruit_description = "持有者的手牌上限为 6-D；超过上限时必须逐张弃置。持有者每弃置 1 张牌便获得 1 点咒波。每回合一次，其可以消耗至多 D+2 点咒波，恢复等同于消耗量的生命或获得消耗量 x2 的护甲。"
industry_card = ExtResource("2_card")
effect = SubResource("Effect")
