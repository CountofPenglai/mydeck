[resource]
script = ExtResource("1_definition")
curse_id = "preservation"
display_name = "守成"
is_boss_curse = true
maturity_threshold = 4
industry_description = "持有者选择另一张深度低于 3 的诅咒并将其加深 1，然后令范围 3 内 1 名敌人获得该诅咒当前深度的报效果，持续到该敌人的下回合结束。所有其他存活敌人获得 2+D 层眩晕。"
report_description = "持有者不能成为其他友方效果的目标。其弃置的牌改为进入放逐区。"
fruit_description = "持有者仍不能成为其他友方效果的目标。持有者预设弃牌或咒波反制模式；每轮首次成为敌方单目标牌的目标时，若能按模式弃置 1 张手牌或消耗 3D 点咒波，则反制整张牌，否则保留本轮反制机会。"
industry_card = ExtResource("2_card")
effect = SubResource("Effect")
