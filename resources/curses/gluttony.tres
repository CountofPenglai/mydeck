[resource]
script = ExtResource("1_definition")
curse_id = "gluttony"
display_name = "饕餮"
is_boss_curse = true
maturity_threshold = 4
industry_description = "持有者选择范围 1 内 1 名敌人。若其当前生命不高于持有者的当前生命 +5×（D-1），令其失去全部生命，并使持有者恢复等同于其实际生命损失的生命；否则持有者失去全部生命。"
report_description = "持有者回合结束时获得 D 点咒波。每有 3 点咒波，持有者的伤害加值与伤害减免各 -1。持有者击杀单位后消耗至多 D+2 点咒波。"
fruit_description = "持有者回合结束时获得 D 点咒波。每有 5 点咒波，持有者的伤害加值与伤害减免各 -1。每场战斗一次，持有者可以消耗全部咒波，处决当前生命不高于所消耗咒波 x2 的敌人；消耗至少 5/10/15/20 点时，依次恢复 5D 生命、抽 2 张牌、获得 2 AP、永久获得 +1 伤害加值，最后一项每个深度仅能获得一次。"
industry_card = ExtResource("2_card")
effect = SubResource("Effect")
