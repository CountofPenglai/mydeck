script = ExtResource("3_effect")
curse_id = "universal_love"

[resource]
script = ExtResource("1_definition")
curse_id = "universal_love"
display_name = "兼爱"
is_boss_curse = true
maturity_threshold = 4
industry_description = "持有者弃置所有其他手牌。令其他存活队友合计抽取队友数量 +D 张牌，每次由当前手牌最少的队友抽 1 张；然后每名其他队友获得 2D 护甲。"
report_description = "持有者选择共享或代受模式。共享：回合结束时，若持有者至少有 D 张手牌，其弃置 D 张手牌，然后每名其他队友各抽 1 张牌。代受：每轮至多 D 次，将范围 3 内其他队友受到的一段伤害转移给持有者。"
fruit_description = "持有者的负荷上限 +2D，其他角色向其转移诅咒不消耗仪式点。共享：回合结束时，若持有者至少有 1 张手牌，其弃置 1 张牌，然后每名其他队友各抽 D 张牌。代受：每轮至多 D 次，将范围 3 内其他队友受到的一段伤害转移给持有者，并使该段伤害 -D。每轮首次有报进入其他队友的诅咒区时，若持有者没有同名诅咒，则改为由持有者获得该报。"
industry_card = ExtResource("2_card")
effect = SubResource("Effect")
