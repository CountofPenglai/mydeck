[sub_resource type="Resource" id="Effect"]
script = ExtResource("3_effect")
curse_id = "gospel"

[resource]
script = ExtResource("1_definition")
curse_id = "gospel"
display_name = "福音"
is_boss_curse = true
maturity_threshold = 4
industry_description = "持有者须拥有多于 3D 点生命才能打出福音之业。持有者失去 3D 点生命，然后对范围 3 内每个其他单位造成 4+2D 加持有者智力伤害加值的伤害。每名实际失去生命的单位获得 D 点咒波，并将 1 张临时辐照咒害洗入其牌库。"
report_description = "持有者的负荷上限 +D。其行动阶段开始时，获得等同于活动诅咒数、至多 3D 点咒波；本阶段每累计消耗 3 点咒波便抽 1 张牌。回合结束时，持有者每有 3 点剩余咒波便失去 1 点生命，至多失去 D 点。"
fruit_description = "持有者的负荷上限 +2D。其行动阶段开始时，获得等同于活动诅咒数、至多 4D 点咒波；本阶段累计消耗 2 点时抽 1 张牌，累计消耗 4 点时再获得 1 AP。回合结束时，持有者每有 5 点剩余咒波便失去 1 点生命，至多失去 D 点。"
hex_keywords = PackedStringArray("福音", "咒波")
industry_card = ExtResource("2_card")
effect = SubResource("Effect")
