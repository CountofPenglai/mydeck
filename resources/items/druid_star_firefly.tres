script = ExtResource("1")
item_name = "无主流萤 / 繁星若虫"
description = "武器打击开始时，基础伤害改为装备者当前可用法力；不能以距离 1 的单位为目标。装备者非强制移动后，在移动起点留下 1 个虫群投影，至多保留 3 个，并在自身回合开始时清空。投影可以作为范围原点；使用投影命中超出装备者自身范围的目标后移除该投影。德鲁伊牌打出后不再进入法力区。"
