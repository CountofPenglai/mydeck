[resource]
script = ExtResource("1")
item_name = "星辉猎弓·夜明扳指 / 无主流萤·繁星若虫"
description = "装备者每回合抽到的第 1 张牌正常进入手牌；本回合之后抽到的牌改为从手牌移入法力区。法力区非空时，装备者获得 +3 伤害加值。每回合可以将法力区最后一张牌移回手牌 1 次；该牌在本次打出中造成正数实际伤害后，星辉轮换依次结算：抽 1 张牌；获得 +3 伤害加值直到下个自身回合结束；将武器范围改为 6 且伤害类型改为智力直到下个自身回合结束。"
