[sub_resource type="Resource" id="Fire"]
script = ExtResource("1")
item_name = "不熄火灵"
description = "装备者获得飞行，武器打击向目标格施加火元素。添薪：将手牌中的第一张牌指定为燃料。装备者每轮首次受到武器范围内敌人的正数实际伤害后，若该燃料仍在手中，则弃置它并自动对伤害来源完成 1 次武器打击；燃料不存在、来源无效或超出范围时不反击。"
