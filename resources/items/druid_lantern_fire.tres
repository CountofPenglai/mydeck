[resource]
script = ExtResource("1")
item_name = "彷徨者提灯 / 不熄火灵"
description = "装备者可以在收纳与启示之间切换预设。装备者请求变为逆位且牌库非空时，以预设效果替代普通变身：收纳将牌库顶牌移入法力区；启示改为抽 1 张牌。点燃：支付 3 法力并消耗本回合的备战次数，直接变为逆位；然后对最近的敌人造成等于支付后剩余可用法力的固定伤害并施加火元素。没有敌人或剩余法力为 0 时仍会变为逆位，但不造成伤害。"
