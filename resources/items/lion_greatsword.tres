[gd_resource type="Resource" script_class="EquipmentData" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/items/equipment_data.gd" id="1_equipment"]
[ext_resource type="Script" path="res://scripts/items/effects/lion_weapon_effect.gd" id="2_effect"]
[ext_resource type="Texture2D" path="res://icon.svg" id="3_icon"]

[sub_resource type="Resource" id="Effect_front"]
script = ExtResource("2_effect")
inverted_face = false

[sub_resource type="Resource" id="Effect_back"]
script = ExtResource("2_effect")
inverted_face = true
next_card_damage_bonus = 3

[sub_resource type="Resource" id="LionRoar"]
script = ExtResource("1_equipment")
item_name = "翼狮咆哮"
description = "备战 1：装备者支付 1 点势，使下一张牌获得 +3 伤害加值；该动作可以重复发动。装备者以逆位完成武器打击后，获得等于该次实际伤害的护甲，然后倒转为怒狮大剑。"
icon = ExtResource("3_icon")
max_stack = 1
base_damage = 7
attack_range = 4
damage_type = 0
equip_slot = 0
equip_category = 1
allowed_classes = PackedInt32Array(1)
rarity = 1
trigger_effects = [SubResource("Effect_back")]
activated_effects = [SubResource("Effect_back")]

[resource]
script = ExtResource("1_equipment")
item_name = "怒狮大剑"
description = "每次切入后且尚未使用本装备打击时，装备者可以免费倒转为翼狮咆哮。装备者每次以正位完成武器打击后获得 1 点势。"
icon = ExtResource("3_icon")
max_stack = 1
base_damage = 5
attack_range = 2
damage_type = 0
equip_slot = 0
equip_category = 1
allowed_classes = PackedInt32Array(1)
rarity = 1
back_face = SubResource("LionRoar")
face_switch_mode = 2
trigger_effects = [SubResource("Effect_front")]
activated_effects = [SubResource("Effect_front")]
