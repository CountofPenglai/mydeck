[resource]
script = ExtResource("1")
item_name = "神代万花筒 / 万元归一者"
description = "装备者每回合开始或切入时随机获得 2 个不同的万象选项，本回合可以发动其中 1 项：借域将最近友方作为双方本回合的额外范围原点；异职发现将 1 张临时“战斗猛击”加入手牌；倒错使本回合武器的基础伤害与范围互换，并使第一张单目标牌复制至最近的另一个合法目标，其复制伤害改为异常与咒波；硬币预押允许选择预押 1 至 3 次，每次成功抽 1 张牌并储存 1 个随机基础元素，任一次失败则当前 AP 变为 0；命运置顶将牌库底牌移至牌库顶。储存的元素由后续武器打击依次消耗。"
icon = ExtResource("3")
base_damage = 5
attack_range = 1
damage_type = 2
equip_slot = 0
equip_category = 0
allowed_classes = PackedInt32Array(4)
rarity = 2
back_face = SubResource("Unifier")
