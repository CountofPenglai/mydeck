[sub_resource type="Resource" id="Unifier"]
script = ExtResource("1")
item_name = "万元归一者"
description = "装备者获得飞行。装备者可以循环切换预设基础元素，武器打击携带当前预设元素。需要支付法力的共鸣牌费用改为 1；本回合第一次支付法力后，若此前未获得法力且尚未返还法力，则获得 1 点临时法力。"
