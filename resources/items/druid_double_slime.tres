[sub_resource type="Resource" id="Slime"]
script = ExtResource("1")
item_name = "黏菌魔像"
description = "装备者每点 AP 提供的移动距离额外增加当前战斗轮数，至多 +3。装备者每回合首次打出双生法术后获得 2 AP。渗流：每回合限 1 次，将弃牌堆顶的 1 至 3 张牌移入法力区，获得每张 2 护甲，并获得等量虚弱层数；每层虚弱使伤害加值 -1，持续至装备者下次回合开始。弃牌堆不足所选数量时不能发动。"
icon = ExtResource("3")
base_damage = 6
attack_range = 1
damage_type = 0
equip_slot = 0
equip_category = 1
allowed_classes = PackedInt32Array(4)
rarity = 2
subcategories = PackedStringArray("druid_weapon", "逆位", "双身")
passive_effects = [SubResource("Effect")]
trigger_effects = [SubResource("Effect")]
activated_effects = [SubResource("Effect")]
[resource]
script = ExtResource("1")
item_name = "双身魔杖 / 黏菌魔像"
description = "战斗开始时，在装备者距离 2 内按距离和坐标顺序寻找最近的空格，部署一个共享同一单位状态的黏菌身体；没有合法空格时不部署。两个身体均视为被装备者占据；正逆位切换时交换两个身体的位置。"
icon = ExtResource("3")
