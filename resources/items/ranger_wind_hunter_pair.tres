[sub_resource type="Resource" id="WindHunter"]
script = ExtResource("1_equipment")
item_name = "乘风猎手"
description = "沿本回合风向进行远程武器打击时，范围 +1 且获得 +1 伤害加值；其他方向范围 -1 且伤害加值 -1，范围最低为 1。若已预备风钉弹，则下一次顺风远程打击消耗它并使存活目标定身，直到目标下次回合结束。"
icon = ExtResource("3_icon")
max_stack = 1
base_damage = 4
attack_range = 3
range_type = 1
damage_type = 1
equip_slot = 0
equip_category = 2
allowed_classes = PackedInt32Array(3)
rarity = 2
subcategories = PackedStringArray("远程", "武器", "模式组件")

[resource]
script = ExtResource("1_equipment")
