[resource]
script = ExtResource("1_card")
card_name = "三相解剖"
description = "对同一目标进行 3 次匕首打击，每次将匕首基础伤害替换为 1；每次正数生命伤害均可独立采集。连击条件：本回合实际加入库存的元素至少 3 枚。"
artwork = ExtResource("2_art")
rarity = 2
card_class = 3
card_type = 0
card_tags = 1
damage_type = 3
target_type = 1
ap_cost = 3
effect = ExtResource("3_effect")
