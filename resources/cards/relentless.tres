[resource]
script = ExtResource("1_card_data")
card_name = "百折不饶"
description = "你从牌库选择 1 张牌置入弃牌堆。\n\n余势：从弃牌堆放逐 3 张牌。改为将你的放逐区中的所有牌洗入牌库，然后进行 1 次武器打击；每洗入 1 张牌，本次打击获得 +2 伤害加值。"
artwork = ExtResource("2_scroll")
rarity = 2
card_class = 1
card_type = 1
target_type = 4
ap_cost = 1
play_timing = 0
range_modifier = 0
override_range = false
card_range = 2
effect = ExtResource("3_effect")
has_momentum = true
momentum_conditions = [ExtResource("4_banish")]
has_combo = false
