[resource]
script = ExtResource("1_card_data")
card_name = "野蛮斗殴"
description = "你对武器范围内所有敌人各进行 1 次武器打击。\n\n余势：支付 2 AP。将目标范围改为武器范围 +2，然后对范围内所有敌人各进行 1 次武器打击。\n\n放逐区：每场战斗限 1 次。你可以弃置所有手牌，将本牌移回你的弃牌堆，并使你打出的下一张牌获得 +2 伤害加值。"
artwork = ExtResource("2_scroll")
rarity = 1
card_class = 1
card_type = 0
card_tags = 1
damage_type = 3
target_type = 5
ap_cost = 2
play_timing = 0
range_modifier = 0
override_range = false
card_range = 2
effect = ExtResource("3_effect")
