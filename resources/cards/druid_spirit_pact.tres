inverted_name = "协猎"
inverted_description = "进行1次武器打击。直到你的下回合开始，范围2内其他具有【根系】的友方角色进行武器打击后，若其目标仍在你的武器范围内，你对同一目标进行1次武器打击。此效果每回合限一次。"
inverted_card_text = "进行1次武器打击。直到你的下回合开始，范围2内其他具有【根系】的友方角色进行武器打击后，若其目标仍在你的武器范围内，你对同一目标进行1次武器打击。此效果每回合限一次。"
inverted_resolution_rules = "首击及附属效果完成后获得状态。协助在友军打击及附属效果完成后再次校验目标存活、射程与合法性；每名角色新回合刷新机会。协助不触发协助；同一施放者重复打出仅刷新持续时间，不重置已用机会。"
inverted_ap_cost = 2
