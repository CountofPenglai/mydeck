[resource]
script = ExtResource("1_card")
card_name = "灵契"
description = "共鸣2。选择范围2内的1名友方角色，选择一项：抽2张牌；对其武器范围内最近的敌人进行1次具有【吸血】的武器打击；获得6点护甲。"
card_text = "共鸣2。选择范围2内的1名友方角色，选择一项：\n· 该角色抽2张牌。\n· 该角色对其武器范围内最近的敌人进行1次具有【吸血】的武器打击。\n· 该角色获得6点护甲。"
resolution_rules = "未支付共鸣时选1项；支付2点当前可用法力后可选任意数量的不同项并按正文顺序结算。自动打击按武器模式、距离和单位ID选择；吸血按实际生命伤害恢复打击者。"
artwork = ExtResource("2_art")
rarity = 1
card_class = 4
