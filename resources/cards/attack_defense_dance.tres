[resource]
script = ExtResource("1_card_data")
card_name = "攻守轮舞"
description = "你以当前武器对目标进行 1 次武器打击，然后尝试切换武器。若切换成功、目标仍存活且在新武器范围内，你再以新武器对其进行 1 次武器打击；否则你获得等同于切换后武器基础伤害的护甲。若没有可切换武器，你获得等同于当前武器基础伤害的护甲。"
