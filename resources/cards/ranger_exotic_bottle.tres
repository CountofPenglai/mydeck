[gd_resource type="Resource" script_class="CardData" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/cards/card_data.gd" id="1_card"]
[ext_resource type="Texture2D" path="res://assets/art/cards/scroll_card_background.png" id="2_art"]
[ext_resource type="Resource" path="res://resources/cards/ranger_exotic_bottle_effect.tres" id="3_effect"]

[resource]
script = ExtResource("1_card")
card_name = "异域爆瓶"
description = "采集你所在格及相邻格中的元素；从本次采集结果选择 1 至 2 种不同基础元素装入爆瓶，余下元素尝试收入库存。对目标格造成基础伤害 8 加敏捷伤害加值，对每个相邻格造成基础伤害 4 加敏捷伤害加值；潜行倍率同时作用于所有伤害。伤害完成后按装载顺序施加元素，并将中心最终地表扩散至相邻格。"
card_text = "采集你所在格及所有相邻格中的元素。选择本次采集的 1 至 2 种不同元素，将其投掷至远程配件范围内的 1 格。\n对目标格造成基础伤害 8 加你的敏捷伤害加值，对所有相邻格造成基础伤害 4 加你的敏捷伤害加值。依次将所选元素施加于目标格，然后将目标格最终生成的元素地表扩散至所有相邻合法格。"
resolution_rules = "游侠所在格及所有相邻合法格中至少存在 1 个当前可采集的元素时，本牌才可打出。持续地表不会因采集被移除，但同一游侠不能重复采集同一来源；元素残留被采集后移除；高级地表拆分为对应的两种基础元素。采集正常触发数量修正、被动和相关事件。本次实际采集结果先进入临时批次，不受元素库存上限阻挡。玩家从临时批次中选择 1 至 2 种不同元素，每种消耗 1 枚作为爆瓶载荷；不能使用原有库存补足。未装入爆瓶的采集结果在选择后尝试进入元素库存，超出库存上限的部分丢失。选择配方、取消配方或关闭载荷窗口都不会采集元素、支付 AP 或移出此牌。必须装备真实的远程配件；目标格使用该配件的实际射程及目标、风向、状态和地表修正，但不要求该武器当前可发动攻击。先对目标格中的敌人与战场对象结算 8 加敏捷伤害加值，并对每个相邻合法格中的敌人与战场对象结算 4 加敏捷伤害加值。潜行倍率同时作用于本牌的全部伤害。伤害全部结算及其普通后续效果完成后，再按玩家选择的顺序将载荷元素依次施加于目标格；每次实际地表变更按通用规则立即结算。所有载荷结算完成后，只将目标格最终生成的元素地表扩散至相邻合法格；相邻格不重复依次结算两枚载荷，扩散到已有地表的格子时正常发生元素反应。攻击后的触发效果在完整爆瓶结算后处理。"
artwork = ExtResource("2_art")
rarity = 2
card_class = 3
card_type = 0
card_tags = 1
damage_type = 1
target_type = 3
ap_cost = 2
override_range = false
card_range = 0
effect = ExtResource("3_effect")
