[resource]
script = ExtResource("1")
card_name = "回锋不止"
description = "你使用当前近战组件进行 1 次武器打击。本牌在弃牌堆时，你可以弃置 1 张手牌，将本牌移回手牌。\n\n连击：近战模式本回合伤害加值 -2（可叠加）。你以 0 AP 进行该近战武器打击。"
card_text = "连击：近战模式本回合伤害加值 -2（可叠加）。使用当前近战组件进行 1 次武器打击。本牌在弃牌堆时，你可以弃置 1 张手牌，将本牌移回手牌。"
resolution_rules = "普通模式支付 1 AP。连击模式按条件叠加本回合近战伤害加值 -2 后进行同一次近战打击；弃牌堆中的回手能力不变。"
