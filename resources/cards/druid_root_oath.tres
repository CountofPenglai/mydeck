[resource]
script = ExtResource("1_card")
card_name = "群根盟誓"
description = "对自身施加【根系】，然后变形。你和全场其他具有【根系】的友方角色各获得4点护甲，且武器打击获得+2伤害加值，持续至你的下回合开始。"
card_text = "对自身施加【根系】，然后变形。你和全场其他具有【根系】的友方角色各获得4点护甲，且武器打击获得+2伤害加值，持续至你的下回合开始。"
resolution_rules = "先对自身施加根系，再变形；快照全场其他根系友军，每名快照受益者获得4护甲和来源绑定的+2武器打击。重复施放刷新同名状态但仍获得护甲。"
artwork = ExtResource("2_art")
rarity = 2
card_class = 4
card_type = 1
target_type = 0
ap_cost = 2
effect = ExtResource("3_effect")
is_druid_dual_card = true
upright_is_transformation = true
inverted_name = "荒野化身"
inverted_description = "附魔。你的武器打击获得+4伤害加值。若你具有【根系】，额外获得等同于战场上具有【根系】的角色数量×2的伤害加值，且你受到的非固定伤害降低3点。"
inverted_card_text = "附魔。你的武器打击获得+4伤害加值。若你具有【根系】，额外获得等同于战场上具有【根系】的角色数量×2的伤害加值，且你受到的非固定伤害降低3点。"
inverted_resolution_rules = "进入自身附魔区；每次武器打击动态检查自身根系与全场根系角色数。无自身根系仍为+4；有自身根系时为+4加全场根系数×2，并只减免非固定伤害3点。同名附魔不叠加。"
inverted_ap_cost = 2
inverted_target_type = 0
